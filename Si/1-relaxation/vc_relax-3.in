&control
    calculation = 'vc-relax'
    prefix = 'silicon'
    outdir = './silicon/'
    pseudo_dir = '../../pseudo/'
    etot_conv_thr = 1e-5
    forc_conv_thr = 1e-4
/

&system
    ibrav=2
    celldm(1) =10.4954550725
    nat=2
    ntyp=1
    ecutwfc=50
    ecutrho = 300 
    occupations = "smearing"
    smearing    = "gaussian"
    degauss     = 0.2 
/

&electrons
    conv_thr=1e-8
/

&ions
/

&cell
    cell_dofree='ibrav'
/

ATOMIC_SPECIES
  Si  28.0855  Si.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS (alat)
Si               0.0017347807        0.0017347807        0.0017347807
Si               0.2517786272        0.2517786272        0.2517786272

K_POINTS (automatic)
  6 6 6 1 1 1


